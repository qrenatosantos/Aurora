# Copie este arquivo para .env.local (no computador) ou cadastre no Cloudflare
# (variáveis de BUILD do Worker). São as ÚNICAS variáveis necessárias. Veja docs/PUBLICAR-NO-CLOUDFLARE.md
#
# Onde achar: Supabase ▸ seu projeto ▸ Project Settings ▸ API (ou botão "Connect").

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" (projetos antigos) OU "publishable" (sb_publishable_..., projetos novos).
# Use UMA das duas linhas abaixo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NUNCA coloque a chave "service_role" / "secret" aqui: ela ignora a segurança do banco.

# OPCIONAL: endereços extras autorizados a enviar pedidos do site (separados por vírgula).
# O site oficial (aurorabartendersaraxa.com.br) já é aceito sem configurar nada.
# ORIGENS_DO_SITE=https://previa-do-site.pages.dev
